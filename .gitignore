*.cache
*.log
*.ldb

# SQLite database files
*.db
*.sqlite
*.sqlite3

# If you want to keep a seed database file, comment the line above and track a single file:
# !app_template.db

# OS-generated files
.DS_Store
Thumbs.db

# Other temp files
*.tmp
*.bak
*.swp